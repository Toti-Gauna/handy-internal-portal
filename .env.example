# Copiá este archivo como .env.local (no se versiona) y completá lo que necesites.

# URL base de Handy-landing-page-be para el portal, sin barra final.
# Vacía: el portal no hace pedidos HTTP (la muestra ?demo=1 sigue funcionando).
# Desarrollo con proxy: /api   ·   Build operativo: https://<backend aprobado>
VITE_API_BASE_URL=

# Solo desarrollo: adónde reenvía Vite los pedidos a /api (no llega al bundle).
API_PROXY_TARGET=http://localhost:3000
